      <circle cx="35" cy="32" r="24" fill="none" stroke="#1d4ed8" stroke-width="1.5" stroke-dasharray="3,2"/>
      <!-- Sailing Ship Graphic -->
      <path d="M 22 36 Q 35 44 48 36 L 44 42 Q 35 46 26 42 Z" fill="#1d4ed8"/>
      <path d="M 35 18 L 35 36 M 35 20 L 44 32 L 35 32 Z M 35 22 L 25 34 L 35 34 Z" fill="#1d4ed8" stroke="#1d4ed8" stroke-width="1"/>
      <!-- Hindi text -->
      <text x="35" y="66" font-family="sans-serif" font-weight="bold" font-size="10" fill="#1d4ed8" text-anchor="middle">स्पाइसेस बोर्ड</text>
    </g>
